# UniLab Backend Environment Configuration
PROJECT_NAME=UniLab
API_V1_STR=/api/v1
ENVIRONMENT=development
PORT=8000

# Database (MongoDB connection URI)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=unilab_db

# Security & Authentication
# Required: generate a unique random value of at least 32 characters.
JWT_SECRET=replace_with_a_unique_random_secret_at_least_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration (comma-separated list of origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://unilab.vercel.app
